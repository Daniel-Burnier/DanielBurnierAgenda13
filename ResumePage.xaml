<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.ResumePage"
             Title="Resumo da Hospedagem"
             BackgroundColor="#F4F6F9">

    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">

        <Label Text="Hospedagem Reservada!" 
               FontSize="22" 
               FontAttributes="Bold" 
               TextColor="#27AE60" 
               HorizontalOptions="Center" />

        <Frame CornerRadius="10" Padding="20" HasShadow="True">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding QuartoSelecionado.Descricao, StringFormat='Acomodação: {0}'}" FontSize="16" FontAttributes="Bold" />
                <Label Text="{Binding QntAdultos, StringFormat='Adultos: {0}'}" />
                <Label Text="{Binding QntCriancas, StringFormat='Crianças: {0}'}" />
                <Label Text="{Binding Estadia, StringFormat='Diárias: {0}'}" />
                <Label Text="{Binding DataCheckIn, StringFormat='Check-in: {0:dd/MM/yyyy}'}" />
                <Label Text="{Binding DataCheckOut, StringFormat='Check-out: {0:dd/MM/yyyy}'}" />

                <BoxView HeightRequest="1" Color="#DDD" Margin="0,5" />

                <Label Text="{Binding ValorTotal, StringFormat='Valor Total: {0:C}'}" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="#1A2B4C" />
            </VerticalStackLayout>
        </Frame>

        <Button Text="Voltar" 
                BackgroundColor="#34495E" 
                TextColor="White" 
                CornerRadius="8" 
                Clicked="Button_Clicked_Voltar" />

    </VerticalStackLayout>
</ContentPage>